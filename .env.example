# --- AWS ---------------------------------------------------------------
OLIST_ACCOUNT=123456789012
OLIST_REGION=us-east-1

# --- Glue Data Catalog --------------------------------------------------
# "olist_catalog" is a Spark-side catalog label wired inside the ETL scripts.
GLUE_CATALOG=olist_catalog
DB_BRONZE=olist_bronze
DB_SILVER=olist_silver
DB_GOLD=olist_gold

# --- S3 buckets (zone + account suffix) --------------------------------
BUCKET_RAW=olist-raw-<ACCOUNT>
BUCKET_BRONZE=olist-bronze-<ACCOUNT>
BUCKET_SILVER=olist-silver-<ACCOUNT>
BUCKET_CURATED=olist-curated-<ACCOUNT>
BUCKET_CODE=olist-code-<ACCOUNT>
BUCKET_ATHENA=olist-athena-<ACCOUNT>
BUCKET_STREAM=olist-stream-<ACCOUNT>

# --- IAM roles ----------------------------------------------------------
ROLE_GLUE_SERVICE=olist-glue-service-role
# Console creates StepFunctions roles under /service-role/ with a random suffix.
# Use the name actually attached to the live state machine (check with:
#   aws stepfunctions describe-state-machine --state-machine-arn ... --query roleArn)
ROLE_SFN=olist-sfn-role
SFN_ROLE_PATH=/
ROLE_LAMBDA=olist-lambda-role
ROLE_REDSHIFT=olist-redshift-role

# --- Glue ETL jobs ------------------------------------------------------
JOB_BRONZE=olist-bronze-etl
JOB_SILVER=olist-silver-etl
JOB_GOLD=olist-gold-etl
GLUE_VERSION=5.1
GLUE_WORKER_TYPE=G.1X
GLUE_WORKERS=2
GLUE_TIMEOUT=30

# --- Step Functions -----------------------------------------------------
STATE_MACHINE=olist-etl-pipeline

# --- Streaming (Kinesis / Lambda / DynamoDB) ---------------------------
KINESIS_STREAM=olist-events
DDB_TABLE=olist-live-metrics
LAMBDA_FUNCTION=olist-stream-ingest
LAMBDA_RUNTIME=python3.14
LAMBDA_HANDLER=lambda_function.lambda_handler
LAMBDA_MEMORY=256
LAMBDA_TIMEOUT=60
LAMBDA_BATCH_SIZE=100
LAMBDA_BATCH_WINDOW=60

# --- Redshift Serverless ------------------------------------------------
REDSHIFT_NAMESPACE=olist-redshift-ns
REDSHIFT_WORKGROUP=olist-redshift-wg
REDSHIFT_ADMIN_USER=admin
REDSHIFT_DB=dev
REDSHIFT_BASE_CAPACITY=8
# SECRET — supply locally, never commit this value
REDSHIFT_ADMIN_PASSWORD=

# --- Local paths --------------------------------------------------------
RAW_CSV_DIR=/home/azam/Downloads/archive
ETL_DIR=glue
SQL_DIR=sql
LAMBDA_SRC=lambdas/kinesis_ingest
LAMBDA_ZIP=/tmp/olist-stream-ingest.zip
ATHENA_RESULTS_PREFIX=results