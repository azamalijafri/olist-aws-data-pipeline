{
  "Comment": "Iceberg medallion pipeline: bronze, silver, gold ETL jobs in sequence",
  "QueryLanguage": "JSONata",
  "StartAt": "RunBronzeEtl",
  "States": {
    "RunBronzeEtl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "${JOB_BRONZE}"
      },
      "Next": "RunSilverEtl",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "Glue.JOB_RUN_FAILED_CANCELED"
          ],
          "Next": "Fail"
        }
      ]
    },
    "RunSilverEtl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "${JOB_SILVER}"
      },
      "Next": "RunGoldEtl",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "Glue.JOB_RUN_FAILED_CANCELED"
          ],
          "Next": "Fail"
        }
      ]
    },
    "RunGoldEtl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "${JOB_GOLD}"
      },
      "Next": "Succeed",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "Glue.JOB_RUN_FAILED_CANCELED"
          ],
          "Next": "Fail"
        }
      ]
    },
    "Succeed": {
      "Type": "Succeed"
    },
    "Fail": {
      "Type": "Fail"
    }
  }
}