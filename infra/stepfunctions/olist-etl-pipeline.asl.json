{
  "Comment": "Iceberg medallion pipeline: bronze, silver, gold ETL jobs in sequence, with notification on success or failure",
  "QueryLanguage": "JSONata",
  "StartAt": "RunBronzeEtl",
  "States": {
    "RunBronzeEtl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "${JOB_BRONZE}"
      },
      "Next": "RunSilverEtl",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "outcome": "failed",
            "failedJob": "bronze"
          },
          "Next": "Outcome"
        }
      ]
    },
    "RunSilverEtl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "${JOB_SILVER}"
      },
      "Next": "RunGoldEtl",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "outcome": "failed",
            "failedJob": "silver"
          },
          "Next": "Outcome"
        }
      ]
    },
    "RunGoldEtl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "${JOB_GOLD}"
      },
      "Next": "MarkSuccess",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "outcome": "failed",
            "failedJob": "gold"
          },
          "Next": "Outcome"
        }
      ]
    },
    "MarkSuccess": {
      "Type": "Pass",
      "Assign": {
        "outcome": "succeeded"
      },
      "Next": "Outcome"
    },
    "Outcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $outcome = 'failed' %}",
          "Next": "NotifyFailure"
        }
      ],
      "Default": "NotifySuccess"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sesv2:sendEmail",
      "Arguments": {
        "FromEmailAddress": "${NOTIFY_FROM}",
        "Destination": {
          "ToAddresses": [
            "${NOTIFY_TO}"
          ]
        },
        "Content": {
          "Simple": {
            "Subject": {
              "Data": "TODO_SUBJECT"
            },
            "Body": {
              "Text": {
                "Data": "TODO_BODY"
              }
            }
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Succeed"
        }
      ],
      "Next": "Succeed"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sesv2:sendEmail",
      "Arguments": {
        "FromEmailAddress": "${NOTIFY_FROM}",
        "Destination": {
          "ToAddresses": [
            "${NOTIFY_TO}"
          ]
        },
        "Content": {
          "Simple": {
            "Subject": {
              "Data": "TODO_SUBJECT"
            },
            "Body": {
              "Text": {
                "Data": "TODO_BODY"
              }
            }
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Fail"
        }
      ],
      "Next": "Fail"
    },
    "Succeed": {
      "Type": "Succeed"
    },
    "Fail": {
      "Type": "Fail"
    }
  }
}
