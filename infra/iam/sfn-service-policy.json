{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartAndPollGlueJobs",
      "Effect": "Allow",
      "Action": [
        "glue:StartJobRun",
        "glue:GetJobRun"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:839553328980:job/olist-silver-etl",
        "arn:aws:glue:us-east-1:839553328980:job/olist-gold-etl"
      ]
    },
    {
      "Sid": "PassGlueRoleForJobs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::839553328980:role/olist-glue-service-role"
    }
  ]
}