{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartAndPollGlueJobs",
      "Effect": "Allow",
      "Action": [
        "glue:StartJobRun",
        "glue:GetJobRun"
      ],
      "Resource": [
        "arn:aws:glue:${OLIST_REGION}:${OLIST_ACCOUNT}:job/${JOB_BRONZE}",
        "arn:aws:glue:${OLIST_REGION}:${OLIST_ACCOUNT}:job/${JOB_SILVER}",
        "arn:aws:glue:${OLIST_REGION}:${OLIST_ACCOUNT}:job/${JOB_GOLD}"
      ]
    },
    {
      "Sid": "PassGlueRoleForJobs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${OLIST_ACCOUNT}:role/${ROLE_GLUE_SERVICE}"
    }
  ]
}